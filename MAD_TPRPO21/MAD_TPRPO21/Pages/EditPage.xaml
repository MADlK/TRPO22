<Page x:Class="MAD_TPRPO21.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MAD_TPRPO21.Pages"
      mc:Ignorable="d" 
      DataContext="{Binding RelativeSource={RelativeSource self}}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="название"/>
            <TextBox Text="{Binding device.Name}"/>
            <TextBlock Text="Цена"/>
            <TextBox Text="{Binding device.Price}"/>
            <TextBlock Text="производитель"/>
            <TextBox Text="{Binding device.Manufacturer}"/>
            <TextBlock Text="Количество"/>
            <TextBox Text="{Binding device.Quantity}"/>
            <TextBlock Text="В продаже"/>
            <CheckBox IsChecked="{Binding device.IsActive}"/>

            <Button Content="Сохранить"
                    Click="Button_Click"/>
            <Button Content="Отмена"
                    Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Page>
