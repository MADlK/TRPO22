<Page x:Class="MAD_TPRPO21.Pages.FullEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MAD_TPRPO21.Pages"
      mc:Ignorable="d" 
      DataContext="{Binding RelativeSource={RelativeSource self}}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FullEditPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Производитель"
                       Margin="10"/>
            <TextBox Text="{Binding device.Manufacturer}"
                     Margin="10 0 10 0"
                     Height="40"/>

            <TextBlock Text="Название"
                       Margin="10"/>
            <TextBox Text="{Binding device.Name}"
                     Margin="10 0 10 0"
                        Height="40"/>

            <TextBlock Text="Цена"
                       Margin="10"/>
            <TextBox Text="{Binding device.Price}"
                    Margin="10 0 10 0"
Height="40"/>

            <TextBlock Text="Количество"
                       Margin="10"/>
            <TextBox Text="{Binding device.Quantity}"
                    Margin="10 0 10 0"
Height="40"/>

            <TextBlock Text="В продаже"
                       Margin="10"/>
            <CheckBox IsChecked="{Binding device.IsActive}"
                     Margin="10 0 10 10"
Height="40"/>

            <StackPanel>
                <Button Content="Добавить"
                        Margin="10"
                        Click="Button_Click"/>
                <Button Content="Назад"
                        Margin="10"
                        Click="Button_Click_1"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
